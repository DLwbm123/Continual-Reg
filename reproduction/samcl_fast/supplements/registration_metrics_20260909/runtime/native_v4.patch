index 0000000..93bcd4c
--- /dev/null
+++ b/core/datasets/paths.py
@@ -0,0 +1,20 @@
+import os
+
+
+def learn2reg_root(cfg):
+    configured = cfg.dataset.get('root', None)
+    root = configured or os.environ.get('LEARN2REG_ROOT')
+    if not root:
+        raise ValueError(
+            'Learn2Reg data root is unset. Set dataset.root or LEARN2REG_ROOT.'
+        )
+    root = os.path.abspath(os.path.expanduser(str(root)))
+    if not os.path.isdir(root):
+        raise FileNotFoundError(f'Learn2Reg data root does not exist: {root}')
+    return root
+
+
